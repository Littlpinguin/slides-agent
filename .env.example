# ============================================================
# slides-agent — environment variables
# ------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored and never committed.
# ============================================================

# --- AI illustration generation (OPTIONAL) ---------------------------------
# Used by the `generate-image` skill (scripts/gen-image.py) to produce
# bespoke, on-brand illustrations and hero images via Google Gemini
# (Nano Banana Pro). This is entirely optional: without a key, decks rely on
# screenshots, icons (assets/icons/) and the design tokens. Adding a key
# unlocks custom illustrations automatically styled to your configured brand
# (palette + illustration style + banned tropes read from brand/).
#
# Get a key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Image model to use. Default is gemini-3-pro-image-preview (Nano Banana Pro).
GOOGLE_AI_IMAGE_MODEL=gemini-3-pro-image-preview
